APP_NAME="Tidemark Billing"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=warning

# The web installer (/install) fills this in. SQLite needs no setup: it uses database/database.sqlite.
DB_CONNECTION=sqlite
# DB_DATABASE=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=
# DB_PASSWORD=

# File-based drivers work everywhere, including shared hosting without a queue worker.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Outgoing mail. "log" writes emails to storage/logs. You can also set SMTP later in Settings → Email.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="billing@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Billing
BILLING_CURRENCY=USD
BILLING_REGISTRATION=true
# For hosts without a command-line cron: call https://your-domain/cron/<token> every minute.
# BILLING_CRON_TOKEN=
# Allow installing, upgrading and deleting plugins from Admin → Plugins by uploading a .zip (plugins run arbitrary PHP; set false to disable).
# BILLING_ALLOW_PLUGIN_UPLOAD=true
# BILLING_PLUGIN_UPLOAD_MAX_MB=16
